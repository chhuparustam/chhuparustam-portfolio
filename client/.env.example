# Public browser-side configuration only — never secrets.
# Nothing here is sensitive: VITE_* values ship inside the JS bundle.

# Local Express API used by the contact form during development.
VITE_API_BASE_URL=http://localhost:5000

# Production: set VITE_API_BASE_URL to the real deployed API origin
# in the hosting platform's environment variables (never commit it).
# Example shape only — the backend is not deployed yet, so there is
# no real value to put here:
# VITE_API_BASE_URL=https://YOUR-PRODUCTION-API.example.com
