# Local development defaults. Production values must be supplied by
# the hosting platform's environment-variable system — never commit
# a real .env (see .gitignore).
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Email delivery (all required at startup; server refuses to start
# without them). RESEND_API_KEY stays server-side only.
RESEND_API_KEY=
CONTACT_TO_EMAIL=chhuparustamkushwaha30@gmail.com
# Verified Resend sender (production needs a real verified sender /
# domain — do not invent one). Empty until configured.
MAIL_FROM=
